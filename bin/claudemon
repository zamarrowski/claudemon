#!/usr/bin/env node

import { mkdirSync } from 'node:fs'
import { resolve } from 'node:path'
import { createGame } from '../server/game.mjs'
import { createServer, portFromEnv } from '../server/server.mjs'
import {
  CARD_NO_OPEN_FLAG,
  CARD_NO_SAVE_HINT,
  CARD_NO_SAVE_MESSAGE,
  CARD_OUT_FLAG,
  CARD_WRITTEN_PREFIX,
  DATASET_MISSING_HINT,
  DATASET_MISSING_MESSAGE,
  SERVING_HINT,
  SERVING_PREFIX,
} from '../src/constants.mjs'
import { bold, brightYellow, dim } from '../src/node/ansi.mjs'
import { openUrl } from '../src/node/browser.mjs'
import { writeCard } from '../src/node/card.mjs'
import { loadDataset } from '../src/node/dataset.mjs'
import { CARD_FILE, HOME } from '../src/node/paths.mjs'
import { revealFile } from '../src/node/reveal.mjs'
import { loadSave } from '../src/node/save.mjs'

const bail = (message, hint) => {
  process.stderr.write(
    `\n  ${brightYellow('◓')} ${bold('claudemon')}\n\n  ${message}\n`,
  )

  if (hint) process.stderr.write(`  ${dim(hint)}\n`)

  process.stderr.write('\n')
  process.exit(1)
}

const outPath = (args) => {
  const flag = args.indexOf(CARD_OUT_FLAG)

  if (flag === -1 || !args[flag + 1]) return CARD_FILE

  return resolve(args[flag + 1])
}

const exportCard = (args) => {
  const save = loadSave()

  if (!save) bail(CARD_NO_SAVE_MESSAGE, CARD_NO_SAVE_HINT)

  const path = writeCard(save, outPath(args))

  process.stdout.write(`${CARD_WRITTEN_PREFIX}${bold(path)}\n`)

  if (!args.includes(CARD_NO_OPEN_FLAG)) revealFile(path)
}

const play = async () => {
  mkdirSync(HOME, { recursive: true })

  const game = createGame()
  const server = createServer({ game, onQuit: () => process.exit(0) })
  const url = await server.listen(portFromEnv())

  game.heartbeat()

  process.stdout.write(
    `\n  ${brightYellow('◓')} ${bold('claudemon')}\n\n  ${SERVING_PREFIX}${bold(url)}\n  ${dim(SERVING_HINT)}\n\n`,
  )

  openUrl(url)

  const stop = () => {
    server.close()
    process.exit(0)
  }

  process.once('SIGINT', stop)
  process.once('SIGTERM', stop)
}

const [command, ...args] = process.argv.slice(2)

try {
  loadDataset()
} catch {
  bail(DATASET_MISSING_MESSAGE, DATASET_MISSING_HINT)
}

if (command === 'card') exportCard(args)
else await play()
